<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Netra.Site" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - NETRA Intelligence</title>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Navigation */
        .sidebar {
            width: 250px;
            background-color: #1e293b;
            border-right: 1px solid #334155;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
        }

        .brand-header {
            padding: 0 20px 20px 20px;
            border-bottom: 1px solid #334155;
            font-size: 1.4rem;
            font-weight: bold;
            color: #06b6d4;
            letter-spacing: 1.5px;
        }

        .nav-menu {
            list-style: none;
            margin-top: 20px;
        }

        .nav-menu li a {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .nav-menu li a:hover {
            background-color: #334155;
            color: #06b6d4;
        }

        /* Main Area */
        .main-wrapper {
            margin-left: 250px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .top-navbar {
            background-color: #1e293b;
            border-bottom: 1px solid #334155;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .content-body {
            padding: 30px;
            flex-grow: 1;
        }

        .footer {
            padding: 15px 30px;
            border-top: 1px solid #334155;
            color: #64748b;
            font-size: 0.85rem;
            text-align: center;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Sidebar Navigation -->
        <div class="sidebar">
            <div class="brand-header">
                🛡️ NETRA
            </div>
            <ul class="nav-menu">
                <li><a href="Default.aspx">📊 Dashboard</a></li>
                <li><a href="RegisterCase.aspx">📄 Register Crime Case</a></li>
                <li><a href="PersonsDirectory.aspx">👥 Persons Directory</a></li>
            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <header class="top-navbar">
                <div><strong>Neural Threat Intelligence Unit</strong></div>
                <div>Analyst: <strong>A. Silva</strong> (Clearance Level 4)</div>
            </header>

            <div class="content-body">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>

            <footer class="footer">
                &copy; <%: DateTime.Now.Year %> NETRA Intelligence Platform - Operational System
            </footer>
        </div>
    </form>
</body>
</html>