<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Netra.Site" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - NETRA Intelligence</title>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #070d18;
            color: #f8fafc;
            overflow-x: hidden;
        }

        form#form1 {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* Sidebar Navigation */
        .sidebar {
            width: 240px;
            min-width: 240px;
            background-color: #0b1320;
            border-right: 1px solid #1e293b;
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .brand-header {
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #1a2536;
        }

        .brand-logo {
            width: 28px;
            height: 28px;
            border: 1px solid #06b6d4;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #06b6d4;
        }

        .brand-text h1 {
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #ffffff;
            line-height: 1;
        }

        .brand-text span {
            font-size: 0.55rem;
            color: #64748b;
            letter-spacing: 0.8px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .nav-list {
            list-style: none;
            padding: 12px 10px;
            flex-grow: 1;
            overflow-y: auto;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 9px 12px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            border-radius: 6px;
            margin-bottom: 2px;
            transition: all 0.15s ease;
        }

        .nav-item a:hover {
            background-color: #162234;
            color: #38bdf8;
        }

        .nav-item.active a {
            background-color: #12283e;
            color: #38bdf8;
            font-weight: 600;
            border-left: 3px solid #38bdf8;
        }

        .sidebar-footer {
            padding: 10px;
            border-top: 1px solid #1a2536;
        }

        /* Main Content Area Stretched to Full Width */
        .main-wrapper {
            margin-left: 240px;
            width: calc(100% - 240px);
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .top-header {
            background-color: #0b1320;
            border-bottom: 1px solid #1e293b;
            padding: 12px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .header-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.5px;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            background-color: #070d18;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 7px 12px 7px 32px;
            color: #f8fafc;
            font-size: 0.8rem;
            width: 240px;
            outline: none;
        }

        .search-box input:focus {
            border-color: #38bdf8;
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 0.8rem;
        }

        .icon-btn {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1rem;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: #38bdf8;
            color: #070d18;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .content-body {
            padding: 25px 30px;
            flex-grow: 1;
            width: 100%;
        }

        /* Responsive Layout Overrides */
        @media (max-width: 1100px) {
            .sidebar { width: 70px; min-width: 70px; }
            .brand-text, .nav-item a span:nth-child(2) { display: none; }
            .main-wrapper { margin-left: 70px; width: calc(100% - 70px); }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Sidebar Navigation -->
        <div class="sidebar">
            <div class="brand-header">
                <div class="brand-logo">👁</div>
                <div class="brand-text">
                    <h1>NETRA</h1>
                    <span>NEURAL INTELLIGENCE UNIT</span>
                </div>
            </div>

            <ul class="nav-list">
                <li class="nav-item active"><a href="Default.aspx"><span>田</span> <span>Dashboard</span></a></li>
                <li class="nav-item"><a href="RegisterCase.aspx"><span>📄</span> <span>Crime Cases</span></a></li>
                <li class="nav-item"><a href="#"><span>🗺️</span> <span>Crime Map</span></a></li>
                <li class="nav-item"><a href="#"><span>📈</span> <span>Analytics</span></a></li>
                <li class="nav-item"><a href="#"><span>🔍</span> <span>Investigation Workspace</span></a></li>
                <li class="nav-item"><a href="PersonsDirectory.aspx"><span>👥</span> <span>Persons</span></a></li>
                <li class="nav-item"><a href="#"><span>🕸️</span> <span>Network Analysis</span></a></li>
                <li class="nav-item"><a href="#"><span>🖼️</span> <span>Image Investigation</span></a></li>
                <li class="nav-item"><a href="#"><span>📊</span> <span>Risk & Anomaly Analysis</span></a></li>
                <li class="nav-item"><a href="#"><span>🔔</span> <span>Alerts</span></a></li>
                <li class="nav-item"><a href="#"><span>🤖</span> <span>AI Assistant</span></a></li>
                <li class="nav-item"><a href="#"><span>📋</span> <span>Reports</span></a></li>
                <li class="nav-item"><a href="#"><span>☁️</span> <span>Bulk Data Import</span></a></li>
                <li class="nav-item"><a href="#"><span>👤</span> <span>User Management</span></a></li>
                <li class="nav-item"><a href="#"><span>⏱️</span> <span>Audit Logs</span></a></li>
            </ul>

            <div class="sidebar-footer">
                <ul class="nav-list" style="padding:0;">
                    <li class="nav-item"><a href="#"><span>⚙️</span> <span>Settings</span></a></li>
                    <li class="nav-item"><a href="#"><span>❓</span> <span>Support</span></a></li>
                </ul>
            </div>
        </div>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-title">NETRA</div>
                <div class="header-controls">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Global Search..." />
                    </div>
                    <button type="button" class="icon-btn">🔔</button>
                    <button type="button" class="icon-btn">🛡️</button>
                    <div class="user-profile">
                        <div class="avatar">MK</div>
                    </div>
                </div>
            </header>

            <!-- Dynamic Body -->
            <div class="content-body">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
</body>
</html>